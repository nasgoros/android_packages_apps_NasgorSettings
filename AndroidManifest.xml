<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nasgoros.settings">

    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="lineageos.permission.MANAGE_REMOTE_PREFERENCES" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_nasgor_settings"
        android:supportsRtl="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <!-- "NasgorOS" entry on the Settings home page -->
        <activity
            android:name=".NasgorSettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="com.nasgoros.settings.NASGOR_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_nasgor_settings" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="false" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-10" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/homepage_summary" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <!-- Moves the LineageParts entries out of the stock Settings categories -->
        <receiver
            android:name=".LineagePartsTiles$BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
