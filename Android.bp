android_app {
    name: "NasgorSettings",

    // Include SettingsLib and it's dependencies
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "com.nasgoros.settings.xml",
    required: ["nasgor-settings-sysconfig"],

    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "SettingsLibPreference",
        "LineagePreferenceLib",
    ],
}

prebuilt_etc {
    name: "nasgor-settings-sysconfig",
    src: "nasgor-settings-sysconfig.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
